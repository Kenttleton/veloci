package page

import (
	"math"
	"strconv"

	"github.com/veloci/veloci/store"
)


templ BudgetPage(shell ShellData, data BudgetData) {
	@Shell(shell) {
		<div class="page-layout">
			<!-- Summary strip -->
			@budgetSummaryStrip(data)
			<!-- Scrollable body: horizon chart + stack panel -->
			<div style="flex:1;overflow-y:auto;display:flex;flex-direction:column;min-height:0">
				@budgetHorizonGraph(data.AllEntryID, data.IncomeEntryID, data.SpendEntryID)
				@budgetStackPanel(data)
			</div>
		</div>
		<script src="/static/js/veloci-chart.js"></script>
		<script>
			(function () {
				var activeGran    = window.__velociGran ? window.__velociGran() : (localStorage.getItem('veloci-gran') || 'day');
				var activeEntryId = null;
				var chart         = null;

				// ── Rate display (all formats pre-rendered by server) ────────────────
				function updateRateDisplays() {
					var attr = activeGran === 'day' ? 'fmtDay' : activeGran === 'year' ? 'fmtYr' : 'fmtMo';
					document.querySelectorAll('[data-fmt-day]').forEach(function (el) {
						el.textContent = el.dataset[attr] || el.dataset.fmtDay;
					});
					var label = activeGran === 'day' ? '/day' : activeGran === 'year' ? '/yr' : '/mo';
					document.querySelectorAll('.js-gran-label').forEach(function (el) {
						el.textContent = label;
					});
				}

				// ── Listen for Shell granularity toggle ───────────────────────────
				document.addEventListener('veloci:granchange', function(e) {
					activeGran = e.detail.gran;
					if (chart) chart.setGranularity(activeGran);
					if (activeEntryId) loadHistory(activeEntryId, null);
					updateRateDisplays();
				});

				// ── Stack panel: collapse/expand ──────────────────────────────────
				var stackCollapsed = false;
				document.addEventListener('click', function (e) {
					var hdr = e.target.closest('#stack-panel-header');
					if (!hdr) return;
					stackCollapsed = !stackCollapsed;
					var body    = document.getElementById('stack-panel-body');
					var chevron = document.getElementById('stack-chevron');
					if (body)    body.style.display    = stackCollapsed ? 'none' : '';
					if (chevron) chevron.textContent   = stackCollapsed ? '▶' : '▼';
				});

				// ── Label group expand/collapse ───────────────────────────────────
				document.addEventListener('click', function (e) {
					var header = e.target.closest('.js-label-group-header');
					if (!header) return;
					var key        = header.dataset.labelKey;
					var isExpanded = header.dataset.expanded === 'true';
					header.dataset.expanded = isExpanded ? 'false' : 'true';
					var chevron = header.querySelector('.js-chevron');
					if (chevron) chevron.textContent = isExpanded ? '▶' : '▼';
					document.querySelectorAll('.js-entry-row[data-label-key="' + key + '"]').forEach(function (r) {
						r.style.display = isExpanded ? 'none' : 'flex';
					});
				});

				// ── Entry selection ───────────────────────────────────────────────
				document.addEventListener('click', function (e) {
					var row = e.target.closest('.js-selectable-entry');
					if (!row) return;
					document.querySelectorAll('.js-selectable-entry').forEach(function (r) {
						r.style.borderLeft = '3px solid transparent';
						r.style.background = '';
					});
					row.style.borderLeft = '3px solid var(--accent)';
					row.style.background = 'var(--surface2)';

					var entryId = row.dataset.entryId;
					var rate    = row.dataset.ratePerDay ? parseFloat(row.dataset.ratePerDay) : null;
					if (chart) chart.setProjection(rate);

					var empty = document.getElementById('chart-empty');
					if (empty) empty.style.display = 'none';

					if (entryId && entryId !== activeEntryId) {
						activeEntryId = entryId;
						loadHistory(entryId, null);
					}
				});

				// ── Chart init (read system entry IDs from canvas data attrs) ────
				var canvas        = document.getElementById('budget-canvas');
				var allEntryId    = canvas ? (canvas.dataset.allEntryId    || null) : null;
				var incomeEntryId = canvas ? (canvas.dataset.incomeEntryId || null) : null;
				var spendEntryId  = canvas ? (canvas.dataset.spendEntryId  || null) : null;

				// ── Summary strip cells (Income / Spend / Margin) ─────────────────
				document.addEventListener('click', function (e) {
					var cell = e.target.closest('.js-summary-cell');
					if (!cell) return;
					var entryId = cell.dataset.entryId;
					if (!entryId || !chart) return;
					activeEntryId = entryId;
					var empty = document.getElementById('chart-empty');
					if (empty) empty.style.display = 'none';
					loadHistory(entryId, null);
					document.querySelectorAll('.js-selectable-entry').forEach(function (r) {
						r.style.borderLeft = '3px solid transparent';
						r.style.background = '';
					});
					var label = document.getElementById('stack-period-label');
					if (label) label.textContent = '';
				});

				// ── Stack Income / Margin anchor → reset chart to All ─────────────
				document.addEventListener('click', function (e) {
					if (!e.target.closest('.js-income-anchor') && !e.target.closest('.js-margin-anchor')) return;
					if (!allEntryId) return;
					activeEntryId = allEntryId;
					loadHistory(allEntryId, null);
					var label = document.getElementById('stack-period-label');
					if (label) label.textContent = '';
					document.querySelectorAll('.js-selectable-entry').forEach(function (r) {
						r.style.borderLeft = '3px solid transparent';
						r.style.background = '';
					});
				});
				if (canvas) {
					chart = new VelociChart(canvas);
					chart.onNeedMore = function (oldest) {
						if (!activeEntryId || !oldest) return;
						loadHistory(activeEntryId, oldest);
					};
					chart.onPeriodClick = function (period) {
						var url = '/budget/stack?date=' + period + '&gran=' + activeGran;
						fetch(url)
							.then(function (r) { if (!r.ok) throw new Error(); return r.text(); })
							.then(function (html) {
								var body = document.getElementById('stack-panel-body');
								if (body) body.innerHTML = html;
								var label = document.getElementById('stack-period-label');
								if (label) label.textContent = period;
								updateRateDisplays();
							})
							.catch(function () {});
					};
				}

				// ── History fetch ─────────────────────────────────────────────────
				function loadHistory(entryId, cursor) {
					var url = '/api/snapshots/' + entryId + '/history?limit=90&granularity=' + activeGran;
					if (cursor) url += '&cursor=' + cursor;
					fetch(url)
						.then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
						.then(function (env) {
							var pts = Array.isArray(env.data) ? env.data : [];
							if (!cursor) chart.load(pts);
							else         chart.prepend(pts);
						})
						.catch(function () {});
				}

				// ── Auto-load All entry on init ───────────────────────────────────
				if (allEntryId) {
					activeEntryId = allEntryId;
					var empty = document.getElementById('chart-empty');
					if (empty) empty.style.display = 'none';
					loadHistory(allEntryId, null);
				}

				// Sync chart gran and rate display to persisted gran on load
				if (chart) chart.setGranularity(activeGran);
				updateRateDisplays();

				// ── Engine job listener: reload page when snapshots complete ─────
				var TX_JOBS = { 'import.process': true, 'account.analyze': true, 'entries.reprocess': true };
				var bgtBadge = document.getElementById('bgt-computing-badge');
				function setBgtComputing(on) {
					if (bgtBadge) bgtBadge.style.display = on ? 'flex' : 'none';
				}
				document.addEventListener('veloci:job', function (e) {
					var evt = e.detail;
					if (!TX_JOBS[evt.job_type]) return;
					if (evt.status === 'queued' || evt.status === 'processing') {
						setBgtComputing(true);
						return;
					}
					if (evt.status === 'complete') {
						window.location.reload();
					}
				});
			})();
		</script>
	}
}

templ budgetSummaryStrip(data BudgetData) {
	<div style="padding:12px 20px 8px;border-bottom:1px solid var(--border);flex-shrink:0">
		<!-- Equation row -->
		<div style="display:flex;gap:8px;align-items:stretch">
			<!-- Income cell -->
			<div class="js-summary-cell" data-entry-id={ data.IncomeEntryID } style="flex:1;padding:12px 16px;background:var(--surface);border-radius:6px;min-width:0;cursor:pointer">
				<div style="font-size:11px;color:var(--text3);margin-bottom:4px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em">Income</div>
				<div style="font-size:22px;font-weight:600;color:var(--text);line-height:1.2">
					<span
						data-fmt-day={ fmtRateDay(&data.Summary.IncomeRate) }
						data-fmt-mo={ fmtRateMo(&data.Summary.IncomeRate) }
						data-fmt-yr={ fmtRateYr(&data.Summary.IncomeRate) }
					>{ fmtRateDay(&data.Summary.IncomeRate) }</span>
				</div>
				<div style="font-size:11px;color:var(--text3);margin-top:2px">
					<span class="js-gran-label">/day</span>
					<span style="margin-left:4px;background:var(--surface2);border-radius:3px;padding:0 5px;font-size:10px;color:var(--text3)">actual</span>
				</div>
			</div>
			<!-- Minus operator -->
			<div style="display:flex;align-items:center;color:var(--text3);font-size:18px;flex-shrink:0">−</div>
			<!-- Spend cell -->
			<div class="js-summary-cell" data-entry-id={ data.SpendEntryID } style="flex:1;padding:12px 16px;background:var(--surface);border-radius:6px;min-width:0;cursor:pointer">
				<div style="font-size:11px;color:var(--text3);margin-bottom:4px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em">Spend</div>
				<div style="font-size:22px;font-weight:600;color:var(--text);line-height:1.2">
					<span
						data-fmt-day={ fmtRateDay(&data.Summary.SpendRate) }
						data-fmt-mo={ fmtRateMo(&data.Summary.SpendRate) }
						data-fmt-yr={ fmtRateYr(&data.Summary.SpendRate) }
					>{ fmtRateDay(&data.Summary.SpendRate) }</span>
				</div>
				<div style="font-size:11px;color:var(--text3);margin-top:2px">
					<span class="js-gran-label">/day</span>
					<span style="margin-left:4px;background:var(--surface2);border-radius:3px;padding:0 5px;font-size:10px;color:var(--text3)">actual</span>
				</div>
			</div>
			<!-- Equals operator -->
			<div style="display:flex;align-items:center;color:var(--text3);font-size:18px;flex-shrink:0">=</div>
			<!-- Margin cell -->
			<div class="js-summary-cell" data-entry-id={ data.AllEntryID } style={ "flex:1;padding:12px 16px;border-radius:6px;min-width:0;cursor:pointer;" + budgetMarginCellBg(data.Summary) }>
				<div style="font-size:11px;color:var(--text3);margin-bottom:4px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em">Margin</div>
				<div style={ "font-size:22px;font-weight:600;line-height:1.2;" + budgetMarginTextColor(data.Summary) }>
					<span
						style={ budgetMarginColor(data.MarginRate) }
						data-fmt-day={ fmtRateDaySigned(&data.MarginRate) }
						data-fmt-mo={ fmtRateMoSigned(&data.MarginRate) }
						data-fmt-yr={ fmtRateYrSigned(&data.MarginRate) }
					>{ fmtRateDaySigned(&data.MarginRate) }</span>
				</div>
				<div style="font-size:11px;color:var(--text3);margin-top:2px">
					<span class="js-gran-label">/day</span>
					· <span style="font-size:10px">{ strconv.Itoa(budgetMarginPct(data.Summary)) }%</span>
					<span style="margin-left:4px;background:var(--surface2);border-radius:3px;padding:0 5px;font-size:10px;color:var(--text3)">actual</span>
				</div>
			</div>
		</div>
		<!-- Proportion bar -->
		<div style="height:3px;border-radius:2px;overflow:hidden;margin-top:8px;background:var(--surface)">
			if budgetIsNegativeMargin(data.Summary) {
				<div style="width:100%;height:100%;background:var(--margin-neg)"></div>
			} else {
				<div style="display:flex;height:100%">
					<div style={ "width:" + strconv.Itoa(budgetCommitPct(data.Summary)) + "%;background:var(--commit);transition:width 0.3s" }></div>
					<div style={ "width:" + strconv.Itoa(budgetMarginPct(data.Summary)) + "%;background:var(--margin-pos);transition:width 0.3s" }></div>
				</div>
			}
		</div>
		<!-- Proportion labels -->
		<div style="display:flex;justify-content:space-between;align-items:center;margin-top:3px">
			<span style="font-size:11px;color:var(--text3)">{ strconv.Itoa(budgetCommitPct(data.Summary)) }% spend</span>
			<div
				id="bgt-computing-badge"
				style={ "display:" + budgetComputingDisplay(data.HasEngineJob) + ";align-items:center;gap:5px;font-size:11px;color:var(--accent)" }
			>
				<span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--accent)"></span>
				Computing…
			</div>
			<span style="font-size:11px;color:var(--text3)">{ strconv.Itoa(budgetMarginPct(data.Summary)) }% margin</span>
		</div>
	</div>
}

templ budgetHorizonGraph(allEntryID, incomeEntryID, spendEntryID string) {
	<div style="padding:8px 20px;display:flex;flex-direction:column;min-height:280px">
		<!-- Legend -->
		<div style="display:flex;gap:16px;align-items:center;margin-bottom:6px;font-size:11px;color:var(--text3);flex-shrink:0">
			<span style="display:flex;align-items:center;gap:4px">
				<span style="width:10px;height:10px;background:var(--margin-pos);display:inline-block;border-radius:1px"></span>
				Ahead
			</span>
			<span style="display:flex;align-items:center;gap:4px">
				<span style="width:10px;height:10px;background:var(--commit);display:inline-block;border-radius:1px"></span>
				Behind
			</span>
			<span style="display:flex;align-items:center;gap:4px">
				<span style="width:16px;height:0;display:inline-block;border-top:2px dashed var(--accent)"></span>
				Projection
			</span>
			<span>body = drift · drag to scroll · click = period</span>
		</div>
		<!-- Chart container -->
		<div style="position:relative;flex:1;min-height:220px">
			<canvas id="budget-canvas" data-all-entry-id={ allEntryID } data-income-entry-id={ incomeEntryID } data-spend-entry-id={ spendEntryID } style="display:block"></canvas>
			<div
				id="chart-empty"
				style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:13px;pointer-events:none"
			>Select an entry to view horizon</div>
		</div>
	</div>
}

templ budgetStackPanel(data BudgetData) {
	<div style="background:var(--bg);border-top:1px solid var(--border);flex-shrink:0">
		<!-- Panel header -->
		<div
			id="stack-panel-header"
			style="display:flex;align-items:center;gap:8px;padding:10px 20px;border-bottom:1px solid var(--border);cursor:pointer;user-select:none"
		>
			<span style="font-weight:600;font-size:13px;color:var(--text)">Stack</span>
			<span id="stack-period-label" style="font-size:12px;color:var(--accent)"></span>
			<div style="flex:1"></div>
			<span style="font-size:11px;color:var(--text3)">entry · type · actual <span class="js-gran-label">/day</span> · drift <span class="js-gran-label">/day</span></span>
			<span id="stack-chevron" style="color:var(--text3);font-size:12px">▼</span>
		</div>
		<div id="stack-panel-body">
			@budgetStackBody(data)
		</div>
	</div>
}

templ budgetStackBody(data BudgetData) {
	<!-- Column headers -->
	<div style="display:flex;align-items:center;padding:6px 20px;border-bottom:1px solid var(--border);gap:8px">
		<div style="font-size:11px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;width:148px">Entry / type</div>
		<div style="font-size:11px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;flex:1">Track</div>
		<div style="font-size:11px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;width:80px;text-align:right">Actual</div>
		<div style="font-size:11px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;width:100px;text-align:right">Drift</div>
	</div>
	<!-- Income anchor -->
	if len(data.Income) > 0 {
		<div class="js-income-anchor" style="display:flex;align-items:center;padding:8px 20px;border-bottom:1px solid var(--border);gap:8px;background:var(--surface);cursor:pointer">
			<div style="width:148px">
				<div style="font-size:13px;font-weight:600;color:var(--income)">Income</div>
				<div style="font-size:11px;color:var(--text3)">anchor</div>
			</div>
			<div style="flex:1">
				<div style="height:4px;border-radius:2px;background:var(--income);width:100%"></div>
			</div>
			<div style="width:80px;text-align:right;color:var(--income);font-weight:600;font-size:13px">
				<span
					data-fmt-day={ fmtRateDay(&data.TotalIncomeRate) }
					data-fmt-mo={ fmtRateMo(&data.TotalIncomeRate) }
					data-fmt-yr={ fmtRateYr(&data.TotalIncomeRate) }
				>{ fmtRateDay(&data.TotalIncomeRate) }</span>
			</div>
			<div style="width:100px;text-align:right;color:var(--text3);font-size:12px">—</div>
		</div>
	}
	<!-- Spend label groups -->
	for _, group := range data.CommitGroups {
		@budgetLabelGroupRow(group, data.TotalIncomeRate)
	}
	<!-- Margin anchor -->
	<div class="js-margin-anchor" style="display:flex;align-items:center;padding:8px 20px;gap:8px;background:var(--surface);cursor:pointer">
		<div style="width:148px">
			<div style={ "font-size:13px;font-weight:600;" + budgetMarginColor(data.MarginRate) }>Margin</div>
			<div style="font-size:11px;color:var(--text3)">anchor</div>
		</div>
		<div style="flex:1">
			if data.TotalIncomeRate > 0 && data.MarginRate > 0 {
				<div style={ "height:4px;border-radius:2px;background:var(--margin-pos);width:" + strconv.Itoa(budgetMarginPct(data.Summary)) + "%" }></div>
			}
		</div>
		<div style={ "width:80px;text-align:right;font-weight:600;font-size:13px;" + budgetMarginColor(data.MarginRate) }>
			<span
				data-fmt-day={ fmtRateDaySigned(&data.MarginRate) }
				data-fmt-mo={ fmtRateMoSigned(&data.MarginRate) }
				data-fmt-yr={ fmtRateYrSigned(&data.MarginRate) }
			>{ fmtRateDaySigned(&data.MarginRate) }</span>
		</div>
		<div style="width:100px;text-align:right;font-size:12px;white-space:nowrap">
			<span
				data-fmt-day={ fmtDriftDaySigned(&data.Summary.DriftRate) }
				data-fmt-mo={ fmtDriftMoSigned(&data.Summary.DriftRate) }
				data-fmt-yr={ fmtDriftYrSigned(&data.Summary.DriftRate) }
			>{ fmtDriftDaySigned(&data.Summary.DriftRate) }</span>
		</div>
	</div>
	if len(data.Income) == 0 && len(data.CommitGroups) == 0 {
		<div style="padding:32px 20px;color:var(--text3);font-size:13px;text-align:center">
			if data.HasEngineJob {
				Computing your first snapshots…
			} else {
				No active entries. Run the engine on the Ledger page to generate budget data.
			}
		</div>
	}
}

templ budgetLabelGroupRow(group BudgetGroup, totalIncomePerDay float64) {
	<!-- Group header -->
	<div
		class="js-label-group-header"
		data-label-key={ budgetGroupKey(group) }
		data-expanded="false"
		style="display:flex;align-items:center;padding:7px 20px;border-bottom:1px solid var(--border);gap:8px;cursor:pointer;background:var(--bg);user-select:none"
	>
		<div style="width:148px;display:flex;align-items:center;gap:6px">
			<span class="js-chevron" style="color:var(--text3);font-size:11px">▶</span>
			<span style="font-size:13px;color:var(--text2);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{ budgetGroupName(group) }</span>
		</div>
		<div style="flex:1">
			<div style={ "height:4px;border-radius:2px;background:var(--commit);width:" + strconv.Itoa(budgetGroupPct(group, totalIncomePerDay)) + "%;opacity:0.6" }></div>
		</div>
		<div style="width:80px;text-align:right;color:var(--text2);font-size:12px">
			<span
				data-fmt-day={ fmtRateDay(&group.ActualRatePerDay) }
				data-fmt-mo={ fmtRateMo(&group.ActualRatePerDay) }
				data-fmt-yr={ fmtRateYr(&group.ActualRatePerDay) }
			>{ fmtRateDay(&group.ActualRatePerDay) }</span>
		</div>
		<div style="width:100px;text-align:right;font-size:12px;white-space:nowrap">
			<span
				data-fmt-day={ fmtDriftDaySigned(&group.DriftPerDay) }
				data-fmt-mo={ fmtDriftMoSigned(&group.DriftPerDay) }
				data-fmt-yr={ fmtDriftYrSigned(&group.DriftPerDay) }
			>{ fmtDriftDaySigned(&group.DriftPerDay) }</span>
		</div>
	</div>
	<!-- Entry detail rows (hidden by default) -->
	for _, e := range group.Entries {
		@budgetEntryDetailRow(e, budgetGroupKey(group), totalIncomePerDay)
	}
}

templ budgetEntryDetailRow(e store.EntryRow, labelKey string, totalIncomePerDay float64) {
	<div
		class="js-entry-row js-selectable-entry"
		data-label-key={ labelKey }
		data-entry-id={ e.ID }
		data-rate-per-day={ budgetEntryRateAttr(e) }
		style="display:none;align-items:center;padding:6px 20px 6px 32px;border-bottom:1px solid var(--border);gap:8px;background:var(--surface);border-left:3px solid transparent;cursor:pointer"
	>
		<div style="width:136px;display:flex;align-items:center;gap:4px">
			<span style="font-size:13px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{ budgetEntryTypeName(e) }</span>
		</div>
		<div style="flex:1">
			<div style={ "height:4px;border-radius:2px;background:var(--commit);width:" + strconv.Itoa(budgetEntryPct(e, totalIncomePerDay)) + "%" }></div>
		</div>
		<div style="width:80px;text-align:right;font-size:13px;color:var(--text)">
			if e.ActualRatePerDay != nil {
				<span
					data-fmt-day={ fmtRateDay(e.ActualRatePerDay) }
					data-fmt-mo={ fmtRateMo(e.ActualRatePerDay) }
					data-fmt-yr={ fmtRateYr(e.ActualRatePerDay) }
				>{ fmtRateDay(e.ActualRatePerDay) }</span>
			} else {
				<span style="color:var(--text3)">—</span>
			}
		</div>
		<div style="width:100px;text-align:right;font-size:12px;white-space:nowrap">
			if e.SnapshotDriftPerDay != nil {
				<span
					data-fmt-day={ fmtDriftDaySigned(e.SnapshotDriftPerDay) }
					data-fmt-mo={ fmtDriftMoSigned(e.SnapshotDriftPerDay) }
					data-fmt-yr={ fmtDriftYrSigned(e.SnapshotDriftPerDay) }
				>{ fmtDriftDaySigned(e.SnapshotDriftPerDay) }</span>
			} else {
				<span style="color:var(--text3)">—</span>
			}
		</div>
	</div>
}

// ── Go helpers ────────────────────────────────────────────────────────────────

func budgetComputingDisplay(computing bool) string {
	if computing {
		return "flex"
	}
	return "none"
}

func budgetCommitPct(s store.SnapshotSummary) int {
	if s.IncomeRate <= 0 {
		return 0
	}
	pct := (math.Abs(s.SpendRate) / s.IncomeRate) * 100
	if pct > 100 {
		return 100
	}
	if pct < 0 {
		return 0
	}
	return int(pct)
}

func budgetMarginPct(s store.SnapshotSummary) int {
	mp := 100 - budgetCommitPct(s)
	if mp < 0 {
		return 0
	}
	return mp
}

func budgetIsNegativeMargin(s store.SnapshotSummary) bool {
	return s.IncomeRate+s.SpendRate < 0
}

func budgetMarginCellBg(s store.SnapshotSummary) string {
	if budgetIsNegativeMargin(s) {
		return "background:color-mix(in srgb, var(--surface) 85%, var(--margin-neg) 15%)"
	}
	return "background:var(--surface)"
}

func budgetMarginTextColor(s store.SnapshotSummary) string {
	if budgetIsNegativeMargin(s) {
		return "color:var(--margin-neg)"
	}
	return "color:var(--text)"
}

func budgetMarginColor(marginPerDay float64) string {
	if marginPerDay > 0 {
		return "color:var(--margin-pos)"
	}
	if marginPerDay < 0 {
		return "color:var(--margin-neg)"
	}
	return "color:var(--text2)"
}

func budgetGroupName(g BudgetGroup) string {
	if g.LabelName != nil && *g.LabelName != "" {
		return *g.LabelName
	}
	return "Unlabeled"
}

func budgetGroupKey(g BudgetGroup) string {
	if g.LabelID != nil {
		return *g.LabelID
	}
	return "__null__"
}

func budgetGroupPct(g BudgetGroup, totalIncomePerDay float64) int {
	if totalIncomePerDay <= 0 {
		return 0
	}
	pct := int((g.ActualRatePerDay / totalIncomePerDay) * 100)
	if pct > 100 {
		return 100
	}
	if pct < 0 {
		return 0
	}
	return pct
}

func budgetEntryTypeName(e store.EntryRow) string {
	switch e.EntryType {
	case "standing":
		return "Standing"
	case "variable":
		return "Variable"
	}
	return e.EntryType
}

func budgetEntryRateAttr(e store.EntryRow) string {
	if e.ActualRatePerDay == nil {
		return ""
	}
	return strconv.FormatFloat(*e.ActualRatePerDay, 'f', 6, 64)
}

func budgetEntryPct(e store.EntryRow, totalIncomePerDay float64) int {
	if e.ActualRatePerDay == nil || totalIncomePerDay <= 0 {
		return 0
	}
	pct := int((*e.ActualRatePerDay / totalIncomePerDay) * 100)
	if pct > 100 {
		return 100
	}
	if pct < 0 {
		return 0
	}
	return pct
}
