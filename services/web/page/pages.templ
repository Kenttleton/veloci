package page

import "github.com/veloci/veloci/store"

// PlaceholderPage renders the shell with a "coming soon" message.
templ PlaceholderPage(data ShellData, name string) {
	@Shell(data) {
		<div class="page-placeholder">{ name } — coming soon</div>
	}
}

// SettingsPage — user profile and security settings.
templ SettingsPage(shell ShellData, u store.User) {
	@Shell(shell) {
		<div style="display:flex;flex-direction:column;height:100%;overflow:hidden">
			<div style="flex:1;overflow:auto;padding:24px 20px">
				<div style="max-width:560px;display:flex;flex-direction:column;gap:32px">
					<!-- Profile -->
					<section>
						<h2 style="margin:0 0 4px;font-size:15px;font-weight:700;color:var(--text)">Profile</h2>
						<p style="margin:0 0 16px;font-size:12px;color:var(--text3)">Your name and how you appear in the app.</p>
						<form id="profile-form" style="display:flex;flex-direction:column;gap:14px">
							<div style="display:flex;gap:12px">
								<div style="flex:1">
									<label style="display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">First Name</label>
									<input id="field-first-name" type="text" value={ u.FirstName } placeholder="First"/>
								</div>
								<div style="flex:1">
									<label style="display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">Last Name</label>
									<input id="field-last-name" type="text" value={ u.LastName } placeholder="Last"/>
								</div>
							</div>
							<div>
								<label style="display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">Preferred Name</label>
								<input id="field-preferred-name" type="text" value={ u.PreferredName } placeholder="How you'd like to be addressed"/>
								<p style="margin:5px 0 0;font-size:11px;color:var(--text3)">First name, full name, or nickname — shown throughout the app.</p>
							</div>
							<div>
								<label style="display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">Email</label>
								<input type="text" value={ u.Email } disabled style="opacity:0.55;cursor:default"/>
							</div>
							<div>
								<label style="display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">Role</label>
								if u.EntityRole == "entity_admin" {
									<span style="display:inline-block;padding:3px 10px;border-radius:16px;font-size:12px;font-weight:600;background:var(--accent);color:#fff">Admin</span>
								} else {
									<span style="display:inline-block;padding:3px 10px;border-radius:16px;font-size:12px;font-weight:600;background:var(--surface2);color:var(--text2);border:1px solid var(--border)">Member</span>
								}
							</div>
							<div style="display:flex;align-items:center;gap:12px;padding-top:2px">
								<button
									type="button"
									onclick="saveProfile()"
									style="background:var(--accent);border:none;border-radius:6px;padding:7px 18px;cursor:pointer;font-size:13px;font-weight:500;color:#fff;font-family:inherit"
								>Save</button>
								<span id="profile-status" style="font-size:12px;color:var(--text3)"></span>
							</div>
						</form>
					</section>
					<!-- Security -->
					<section>
						<h2 style="margin:0 0 4px;font-size:15px;font-weight:700;color:var(--text)">Security</h2>
						<p style="margin:0 0 16px;font-size:12px;color:var(--text3)">Update your email or password. Both require your current password to confirm.</p>
						<!-- Change Email -->
						<div style="border:1px solid var(--border);border-radius:8px;padding:16px;margin-bottom:16px">
							<h3 style="margin:0 0 14px;font-size:13px;font-weight:600;color:var(--text)">Change Email</h3>
							<div style="display:flex;flex-direction:column;gap:12px">
								<div>
									<label style="display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">New Email</label>
									<input id="field-new-email" type="email" placeholder="new@example.com"/>
								</div>
								<div>
									<label style="display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">Current Password</label>
									<input id="field-email-password" type="password" placeholder="Your current password"/>
								</div>
								<div style="display:flex;align-items:center;gap:12px;padding-top:2px">
									<button
										type="button"
										onclick="changeEmail()"
										style="background:var(--accent);border:none;border-radius:6px;padding:7px 18px;cursor:pointer;font-size:13px;font-weight:500;color:#fff;font-family:inherit"
									>Update Email</button>
									<span id="email-status" style="font-size:12px;color:var(--text3)"></span>
								</div>
							</div>
						</div>
						<!-- Change Password -->
						<div style="border:1px solid var(--border);border-radius:8px;padding:16px">
							<h3 style="margin:0 0 14px;font-size:13px;font-weight:600;color:var(--text)">Change Password</h3>
							<div style="display:flex;flex-direction:column;gap:12px">
								<div>
									<label style="display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">Current Password</label>
									<input id="field-current-password" type="password"/>
								</div>
								<div>
									<label style="display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">New Password</label>
									<input id="field-new-password" type="password"/>
								</div>
								<div>
									<label style="display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">Confirm New Password</label>
									<input id="field-confirm-password" type="password"/>
								</div>
								<div style="display:flex;align-items:center;gap:12px;padding-top:2px">
									<button
										type="button"
										onclick="changePassword()"
										style="background:var(--accent);border:none;border-radius:6px;padding:7px 18px;cursor:pointer;font-size:13px;font-weight:500;color:#fff;font-family:inherit"
									>Change Password</button>
									<span id="password-status" style="font-size:12px;color:var(--text3)"></span>
								</div>
							</div>
						</div>
					</section>
				</div>
			</div>
		</div>
		<script>
		function saveProfile() {
			const status = document.getElementById('profile-status');
			fetch('/api/users/me', {
				method: 'PUT',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({
					first_name:     document.getElementById('field-first-name').value,
					last_name:      document.getElementById('field-last-name').value,
					preferred_name: document.getElementById('field-preferred-name').value,
				}),
			}).then(r => {
				if (r.ok) {
					status.style.color = 'var(--green, #22c55e)';
					status.textContent = 'Saved.';
				} else {
					status.style.color = 'var(--red, #ef4444)';
					status.textContent = 'Save failed.';
				}
				setTimeout(() => { status.textContent = ''; }, 3000);
			});
		}

		function changeEmail() {
			const status = document.getElementById('email-status');
			const newEmail = document.getElementById('field-new-email').value.trim();
			const password = document.getElementById('field-email-password').value;
			if (!newEmail || !password) {
				status.style.color = 'var(--red, #ef4444)';
				status.textContent = 'All fields required.';
				return;
			}
			fetch('/api/users/me/email', {
				method: 'PUT',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({email: newEmail, current_password: password}),
			}).then(r => {
				if (r.ok) {
					status.style.color = 'var(--green, #22c55e)';
					status.textContent = 'Email updated. You may need to log in again.';
					document.getElementById('field-new-email').value = '';
					document.getElementById('field-email-password').value = '';
				} else if (r.status === 401) {
					status.style.color = 'var(--red, #ef4444)';
					status.textContent = 'Current password is incorrect.';
				} else if (r.status === 409) {
					status.style.color = 'var(--red, #ef4444)';
					status.textContent = 'That email is already in use.';
				} else {
					status.style.color = 'var(--red, #ef4444)';
					status.textContent = 'Update failed.';
				}
			});
		}

		function changePassword() {
			const status = document.getElementById('password-status');
			const current = document.getElementById('field-current-password').value;
			const next    = document.getElementById('field-new-password').value;
			const confirm = document.getElementById('field-confirm-password').value;
			if (!current || !next || !confirm) {
				status.style.color = 'var(--red, #ef4444)';
				status.textContent = 'All fields required.';
				return;
			}
			if (next !== confirm) {
				status.style.color = 'var(--red, #ef4444)';
				status.textContent = 'New passwords do not match.';
				return;
			}
			fetch('/api/users/me/password', {
				method: 'PUT',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({current_password: current, new_password: next}),
			}).then(r => {
				if (r.ok) {
					status.style.color = 'var(--green, #22c55e)';
					status.textContent = 'Password changed.';
					document.getElementById('field-current-password').value = '';
					document.getElementById('field-new-password').value = '';
					document.getElementById('field-confirm-password').value = '';
				} else if (r.status === 401) {
					status.style.color = 'var(--red, #ef4444)';
					status.textContent = 'Current password is incorrect.';
				} else {
					status.style.color = 'var(--red, #ef4444)';
					status.textContent = 'Change failed.';
				}
			});
		}
		</script>
	}
}
